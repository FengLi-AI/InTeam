# 复制为 .env 并填入真实值（开发期可留空用演示模式；验收前必须填 DEEPSEEK_API_KEY）
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
MAX_REQUEST_BODY_BYTES=65536
SESSION_SECRET=
INVITE_PEPPER=
SESSION_COOKIE_NAME=inteam_session
ADMIN_USER_IDS=
ADMIN_OPEN_IDS=
SERVICE_TOKEN=
ALLOW_ALL_AUTHENTICATED_DOCS=true
DOC_ACL_JSON={}
ALLOWED_SOURCE_HOSTS=feishu.cn,open.feishu.cn
# 前端外链二次校验，通常与上面保持一致（会公开到浏览器，不能填密钥）
NEXT_PUBLIC_ALLOWED_SOURCE_HOSTS=feishu.cn,open.feishu.cn
BACKEND_URL=http://127.0.0.1:8000
PROMPT_GUARD_MODE=monitor
OUTPUT_GUARD_MODE=monitor
CSP_MODE=report-only
SENTRY_DSN=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
MAX_TOKENS=1024
TIMEOUT_SECONDS=60
CONFIDENCE_THRESHOLD=0.4

# InTeam v1.6 Dify Chatflow；完成真实联调前保持 legacy
CHAT_PROVIDER=legacy
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_APP_API_KEY=
DIFY_CONNECT_TIMEOUT_SECONDS=10
DIFY_READ_TIMEOUT_SECONDS=120

# 第 2 阶段：飞书文档只读同步
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_DOC_TOKENS=
# 出处跳转链接前缀（默认飞书通用跳转，可改为租户域名）
FEISHU_DOC_URL_PREFIX=https://feishu.cn/docx/

# 第 2 阶段：火山方舟文本向量化
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_EMBEDDING_MODEL=doubao-embedding-vision-251215

# 第 2 阶段：向量库目录（默认系统盘；项目在 exFAT 磁盘时 Chroma 不可写，勿改回项目内）
# VECTORDB_DIR=

# 第 3 阶段：转人工通知（留空或 mock=模拟发送到本地收件箱；填真实 open_id=真实飞书消息）
FEISHU_MENTOR_ID=
FEISHU_RECEIVE_ID_TYPE=open_id

# 第 3 阶段：关系型数据库（默认 SQLite，无需改动）
# DATABASE_URL=sqlite:///backend/data/app.db

# 线上 SQLite 持久化：火山引擎 TOS 的 S3 兼容接口
TOS_BACKUP_ENABLED=false
S3_ENDPOINT=https://tos-s3-cn-beijing.volces.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=cn-beijing
S3_BACKUP_PREFIX=inteam/backups
BACKUP_INTERVAL_SECONDS=3600
BACKUP_RETENTION_COUNT=24

# 第 4 阶段：飞书 OAuth 登录
ENABLE_FEISHU_OAUTH=false
FEISHU_AUTH_REDIRECT_URI=http://localhost:3000/auth/callback
SESSION_TTL_DAYS=30

# 资源保护（Staging 观察后再调整）
INVITE_ATTEMPT_LIMIT=5
INVITE_ATTEMPT_WINDOW_SECONDS=900
CHAT_RATE_LIMIT=10
CHAT_RATE_WINDOW_SECONDS=60
CHAT_HOURLY_LIMIT=60
CHAT_CONCURRENCY_PER_USER=2
CHAT_CONCURRENCY_GLOBAL=20
ESCALATE_RATE_LIMIT=5
ESCALATE_RATE_WINDOW_SECONDS=3600
FEEDBACK_RATE_LIMIT=30
FEEDBACK_RATE_WINDOW_SECONDS=3600
